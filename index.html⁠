<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Simulatore Biomeccanico 3D</title>
    <style>
        body { margin: 0; overflow: hidden; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: #0f172a; color: #f8fafc; }
        #canvas-container { width: 100vw; height: 100vh; display: block; }
        #ui-panel {
            position: absolute; top: 15px; left: 15px; width: 300px;
            background: rgba(15, 23, 42, 0.85); backdrop-filter: blur(8px);
            padding: 16px; border-radius: 12px; border: 1px solid #334155;
            box-shadow: 0 10px 25px rgba(0,0,0,0.5); font-size: 14px;
        }
        .control-group { margin-bottom: 12px; }
        label { display: flex; justify-content: space-between; margin-bottom: 4px; font-weight: 600; color: #cbd5e1; }
        input[type=range] { width: 100%; accent-color: #38bdf8; cursor: pointer; }
        #metrics-panel {
            position: absolute; top: 15px; right: 15px; width: 260px;
            background: rgba(15, 23, 42, 0.85); backdrop-filter: blur(8px);
            padding: 16px; border-radius: 12px; border: 1px solid #334155;
            box-shadow: 0 10px 25px rgba(0,0,0,0.5); font-size: 14px;
        }
        .metric-card { background: #1e293b; padding: 10px 12px; border-radius: 8px; margin-bottom: 8px; }
        .metric-title { font-size: 11px; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.5px; }
        .metric-value { font-size: 18px; font-weight: bold; color: #38bdf8; margin-top: 2px; }
        .status-badge { display: inline-block; padding: 4px 10px; border-radius: 20px; font-size: 12px; font-weight: bold; }
        .status-compatible { background: #065f46; color: #34d399; }
        .status-incompatible { background: #881337; color: #f87171; }
    </style>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>
</head>
<body>
    <div id="canvas-container"></div>
    
    <div id="ui-panel">
        <h3 style="margin-top:0; color:#38bdf8; font-size: 16px;">Parametri Biomeccanici</h3>
        <div class="control-group">
            <label>Carico Bilanciere (kg): <span id="val-load">60</span></label>
            <input type="range" id="slider-load" min="0" max="200" value="60">
        </div>
        <div class="control-group">
            <label>Inclinazione Tibia (°): <span id="val-tibia">15</span></label>
            <input type="range" id="slider-tibia" min="0" max="45" value="15">
        </div>
        <div class="control-group">
            <label>Flessione Ginocchio (°): <span id="val-knee">60</span></label>
            <input type="range" id="slider-knee" min="0" max="120" value="60">
        </div>
        <div class="control-group">
            <label>Inclinazione Busto (°): <span id="val-trunk">45</span></label>
            <input type="range" id="slider-trunk" min="0" max="80" value="45">
        </div>
    </div>

    <div id="metrics-panel">
        <h3 style="margin-top:0; color:#38bdf8; font-size: 16px;">Momenti Articolari</h3>
        <div class="metric-card">
            <div class="metric-title">Momento Anca</div>
            <div class="metric-value"><span id="metric-hip">0</span> N·m</div>
        </div>
        <div class="metric-card">
            <div class="metric-title">Momento Ginocchio</div>
            <div class="metric-value"><span id="metric-knee">0</span> N·m</div>
        </div>
        <div class="metric-card">
            <div class="metric-title">Stato Equilibrio</div>
            <div style="margin-top:6px;"><span id="metric-status" class="status-badge status-compatible">Compatibile</span></div>
        </div>
    </div>

    <script>
        const container = document.getElementById('canvas-container');
        const scene = new THREE.Scene();
        scene.background = new THREE.Color(0x0f172a);

        const camera = new THREE.PerspectiveCamera(45, window.innerWidth / window.innerHeight, 0.1, 100);
        camera.position.set(2.5, 1.2, 3.5);

        const renderer = new THREE.WebGLRenderer({ antialias: true });
        renderer.setSize(window.innerWidth, window.innerHeight);
        renderer.shadowMap.enabled = true;
        container.appendChild(renderer.domElement);

        const controls = new THREE.OrbitControls(camera, renderer.domElement);
        controls.target.set(0, 0.8, 0);
        controls.update();

        const ambientLight = new THREE.AmbientLight(0xffffff, 0.6);
        scene.add(ambientLight);
        const dirLight = new THREE.DirectionalLight(0xffffff, 0.8);
        dirLight.position.set(5, 10, 7);
        scene.add(dirLight);

        const gridHelper = new THREE.GridHelper(10, 20, 0x38bdf8, 0x334155);
        scene.add(gridHelper);

        const matJoint = new THREE.MeshStandardMaterial({ color: 0x38bdf8 });
        const matBone = new THREE.MeshStandardMaterial({ color: 0xe2e8f0 });
        const matBar = new THREE.MeshStandardMaterial({ color: 0xf59e0b });
        const matForce = new THREE.LineBasicMaterial({ color: 0xef4444, linewidth: 2 });

        function createSphere(radius) {
            const mesh = new THREE.Mesh(new THREE.SphereGeometry(radius, 16, 16), matJoint);
            scene.add(mesh);
            return mesh;
        }

        function createCylinder(radius, length) {
            const mesh = new THREE.Mesh(new THREE.CylinderGeometry(radius, radius, length, 16), matBone);
            scene.add(mesh);
            return mesh;
        }

        const jAnkle = createSphere(0.05);
        const jKnee = createSphere(0.05);
        const jHip = createSphere(0.06);
        const jShoulder = createSphere(0.05);

        const boneTibia = createCylinder(0.025, 1);
        const boneFemur = createCylinder(0.025, 1);
        const boneTrunk = createCylinder(0.035, 1);

        const barMesh = new THREE.Mesh(new THREE.CylinderGeometry(0.03, 0.03, 1.2, 16), matBar);
        barMesh.rotation.z = Math.PI / 2;
        scene.add(barMesh);

        const forceLineGeo = new THREE.BufferGeometry().setFromPoints([new THREE.Vector3(), new THREE.Vector3()]);
        const forceLine = new THREE.Line(forceLineGeo, matForce);
        scene.add(forceLine);

        const L_tibia = 0.45;
        const L_femur = 0.45;
        const L_trunk = 0.55;

        function updateSegment(mesh, p1, p2, length) {
            mesh.position.copy(p1).add(p2).multiplyScalar(0.5);
            mesh.scale.set(1, length, 1);
            mesh.quaternion.setFromUnitVectors(new THREE.Vector3(0, 1, 0), p2.clone().sub(p1).normalize());
        }

        function updateKinematics() {
            const load = parseFloat(document.getElementById('slider-load').value);
            const radTibia = parseFloat(document.getElementById('slider-tibia').value) * Math.PI / 180;
            const radKnee = parseFloat(document.getElementById('slider-knee').value) * Math.PI / 180;
            const radTrunk = parseFloat(document.getElementById('slider-trunk').value) * Math.PI / 180;

            document.getElementById('val-load').innerText = load;
            document.getElementById('val-tibia').innerText = document.getElementById('slider-tibia').value;
            document.getElementById('val-knee').innerText = document.getElementById('slider-knee').value;
            document.getElementById('val-trunk').innerText = document.getElementById('slider-trunk').value;

            const pAnkle = new THREE.Vector3(0, 0.05, 0);
            const pKnee = new THREE.Vector3(pAnkle.x + L_tibia * Math.sin(radTibia), pAnkle.y + L_tibia * Math.cos(radTibia), 0);
            const angleFemur = radKnee - radTibia;
            const pHip = new THREE.Vector3(pKnee.x - L_femur * Math.sin(angleFemur), pKnee.y + L_femur * Math.cos(angleFemur), 0);
            const pShoulder = new THREE.Vector3(pHip.x + L_trunk * Math.sin(radTrunk), pHip.y + L_trunk * Math.cos(radTrunk), 0);

            jAnkle.position.copy(pAnkle);
            jKnee.position.copy(pKnee);
            jHip.position.copy(pHip);
            jShoulder.position.copy(pShoulder);

            updateSegment(boneTibia, pAnkle, pKnee, L_tibia);
            updateSegment(boneFemur, pKnee, pHip, L_femur);
            updateSegment(boneTrunk, pHip, pShoulder, L_trunk);

            barMesh.position.copy(pShoulder);

            const positions = forceLine.geometry.attributes.position.array;
            positions[0] = pShoulder.x; positions[1] = pShoulder.y; positions[2] = pShoulder.z;
            positions[3] = pShoulder.x; positions[4] = 0;           positions[5] = pShoulder.z;
            forceLine.geometry.attributes.position.needsUpdate = true;

            // Calcolo Momenti ($M = F \cdot d$)
            const force = load * 9.81;
            const leverArmHip = Math.abs(pShoulder.x - pHip.x);
            const leverArmKnee = Math.abs(pShoulder.x - pKnee.x);

            document.getElementById('metric-hip').innerText = Math.round(force * leverArmHip);
            document.getElementById('metric-knee').innerText = Math.round(force * leverArmKnee);

            const statusEl = document.getElementById('metric-status');
            if (pShoulder.x >= -0.12 && pShoulder.x <= 0.18) {
                statusEl.innerText = "Compatibile";
                statusEl.className = "status-badge status-compatible";
            } else {
                statusEl.innerText = "Non compatibile";
                statusEl.className = "status-badge status-incompatible";
            }
        }

        ['slider-load', 'slider-tibia', 'slider-knee', 'slider-trunk'].forEach(id => {
            document.getElementById(id).addEventListener('input', updateKinematics);
        });

        window.addEventListener('resize', () => {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        });

        updateKinematics();

        function animate() {
            requestAnimationFrame(animate);
            renderer.render(scene, camera);
        }
        animate();
    </script>
</body>
</html>
